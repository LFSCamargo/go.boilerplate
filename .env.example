# App listen port (always 5000 in Docker; nginx publishes :8080).
PORT=5000
NGINX_PORT=8080
POSTGRES_CONNECTION=postgres://goboilerplate:goboilerplate@localhost:5432/goboilerplate?sslmode=disable
BEARER_SECRET=dev-secret-key-at-least-32-characters-long
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Compose (make up-dev / make up-prod)
POSTGRES_USER=goboilerplate
POSTGRES_PASSWORD=goboilerplate
POSTGRES_DB=goboilerplate
POSTGRES_PORT=5432

# Logging (pretty = Pino-style dev output, json = production)
LOG_LEVEL=info
LOG_FORMAT=pretty

# Auth rate limits (per IP, fixed window)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MINUTES=1

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@go.boilerplate
EMAILS_DIR=emails
EMAIL_ASSETS_BASE_URL=http://localhost:8080
APP_PUBLIC_URL=http://localhost:8080
UPLOADS_DIR=uploads
